GEMINI_API_KEY=

# --- Optional (defaults shown) ---
# LLM for answers: gemini, or ollama (local Qwen2.5; install Ollama, then `ollama pull qwen2.5:3b`)
# LLM_PROVIDER=gemini
# OLLAMA_MODEL=qwen2.5:3b
# LLM_FALLBACK_TO_OLLAMA=true
# Printed-text OCR: auto (Tesseract if installed, else docTR), tesseract, or doctr
# OCR_ENGINE=auto
# Handwriting line finder: doctr or projection; erase notebook rules first
# HTR_SEGMENTER=doctr
# REMOVE_RULED_LINES=true
# TrOCR temperature scaling; fit with `python -m evaluation.fit_htr_temperature`
# HTR_TEMPERATURE=1.0
